<h1>出産準備リスト</h1>
<p>赤ちゃんとママのための準備を進めましょう！</p>
<hr>
<h2>準備アイテムを追加</h2>
<%= form_with model: PreparationItem.new, url: preparation_items_path do |form| %>
  <div>
    <%= form.label :name, "アイテム名" %>
    <%= form.text_field :name, placeholder: "例：ベビーカー" %>
  </div>
  <div>
    <%= form.label :category, "カテゴリ" %>
    <%= form.select :category, [["赤ちゃん", "baby"], ["ママ", "mother"]] %>
  </div>
  <%= form.submit "追加する" %>
<% end %>
<% if @preparation_items.any? %>
  <% @preparation_items.each do |item| %>
    <div>
      <h2><%= item.name %></h2>
      <p> カテゴリ： <%= item.baby? ? "赤ちゃん" : "ママ" %> </p>
      <p> 準備状況： <%= item.ready? ? "準備OK" : "これから" %> </p>
      <% if item.ready? %>
        <%= button_to "これからに戻す",
        preparation_item_path(item),
        method: :patch,
        params: { status: "unprepared" } %>
      <% else %>
        <%= button_to "準備OKにする",
        preparation_item_path(item),
        method: :patch,
        params: { status: "ready" } %>
      <% end %>
      <%= button_to "削除する",
          preparation_item_path(item),
          method: :delete,
          form: { data: { turbo_confirm: "このアイテムを削除しますか？" } } %>
    </div>
    <hr>
  <% end %>
<% else %>
  <p>準備アイテムはまだありません。</p>
<% end %>
<hr>

<h2>これから準備するもの</h2>

<% if @unprepared_items.any? %>
  <% @unprepared_items.each do |item| %>
    <p>
      <%= item.name %>
      （<%= item.baby? ? "赤ちゃん" : "ママ" %>）
    </p>
  <% end %>
<% else %>
  <p>これから準備するものはありません！</p>
<% end %>

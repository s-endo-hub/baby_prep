<% if notice.present? %>
  <p><%= notice %></p>
<% end %>
<% if alert.present? %>
  <p><%= alert %></p>
<% end %>
<div>
  <p>こんにちは、<%= current_user.name %>さん！</p>
  <%= button_to "ログアウト",
      destroy_user_session_path,
      method: :delete %>
</div>
<h1>出産準備リスト</h1>
<p>赤ちゃんとママのための準備を進めましょう！</p>
<hr>
<div class="dashboard">
  <section class="dashboard-card due-date-card">
    <h2>出産予定日まで</h2>

    <% if @days_until_due.positive? %>
      <p class="dashboard-number">
        あと <%= @days_until_due %> 日
      </p>
      <p>赤ちゃんに会える日が近づいています。</p>
    <% elsif @days_until_due.zero? %>
      <p class="dashboard-number">今日が予定日です！</p>
    <% else %>
      <p class="dashboard-number">
        <%= @days_until_due.abs %> 日経過
      </p>
      <p>出産予定日を過ぎています。</p>
    <% end %>
  </section>

  <section class="dashboard-card progress-card">
    <h2>準備の進捗</h2>

    <p class="dashboard-number">
      <%= @progress_rate %>%
    </p>

    <p>
      <%= @ready_items_count %> /
      <%= @total_items %> 件準備OK
    </p>

    <progress value="<%= @progress_rate %>" max="100"></progress>
  </section>
</div>
<hr>
<h2>準備アイテムを追加</h2>
<%= form_with model: PreparationItem.new, url: preparation_items_path do |form| %>
  <div>
    <%= form.label :name, "アイテム名" %>
    <%= form.text_field :name, placeholder: "例：ベビーカー" %>
  </div>
  <div>
    <%= form.label :category, "カテゴリ" %>
    <%= form.select :category, [["赤ちゃん", "baby"], ["ママ", "mother"]] %>
  </div>
  <%= form.submit "追加する" %>
<% end %>
<hr>
<% baby_items = @preparation_items.select(&:baby?) %>
<% mother_items = @preparation_items.select(&:mother?) %>

<div class="preparation-checklist">
  <%# 赤ちゃんの準備物：最初から開く %>
  <details class="preparation-category" open>
    <summary class="preparation-category-title">
      <span>👶 赤ちゃんの準備物</span>
      <span><%= baby_items.size %>件</span>
    </summary>

    <div class="preparation-items">
      <% if baby_items.any? %>
        <% baby_items.each do |item| %>
            <div class="preparation-card">
            <div class="preparation-card-header">
                <h2><%= item.name %></h2>

                <% if item.ready? %>
                  <span class="status-label status-ready">準備OK</span>
                <% else %>
                  <span class="status-label status-unprepared">これから</span>
                <% end %>
            </div>

            <div class="preparation-card-actions">
            <% if item.ready? %>
                <%= button_to "これからに戻す",
                    preparation_item_path(item),
                    method: :patch,
                    params: { status: "unprepared" },
                    class: "button-secondary" %>
            <% else %>
                <%= button_to "準備OKにする",
                    preparation_item_path(item),
                    method: :patch,
                    params: { status: "ready" },
                    class: "button-primary" %>
            <% end %>

            <%= button_to "削除する",
                preparation_item_path(item),
                method: :delete,
                form: { data: { turbo_confirm: "このアイテムを削除しますか？" } },
                class: "button-delete" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p>赤ちゃんの準備アイテムはまだありません。</p>
      <% end %>
    </div>
  </details>

  <%# ママの準備物：最初は閉じる %>
  <details class="preparation-category">
    <summary class="preparation-category-title">
      <span>🤰 ママの準備物</span>
      <span><%= mother_items.size %>件</span>
    </summary>

    <div class="preparation-items">
      <% if mother_items.any? %>
        <% mother_items.each do |item| %>
            <div class="preparation-card">
            <div class="preparation-card-header">
                <h2><%= item.name %></h2>

                <% if item.ready? %>
                  <span class="status-label status-ready">準備OK</span>
                <% else %>
                  <span class="status-label status-unprepared">これから</span>
                <% end %>
            </div>

            <div class="preparation-card-actions">
            <% if item.ready? %>
                <%= button_to "これからに戻す",
                    preparation_item_path(item),
                    method: :patch,
                    params: { status: "unprepared" },
                    class: "button-secondary" %>
            <% else %>
                <%= button_to "準備OKにする",
                    preparation_item_path(item),
                    method: :patch,
                    params: { status: "ready" },
                    class: "button-primary" %>
            <% end %>

            <%= button_to "削除する",
                preparation_item_path(item),
                method: :delete,
                form: { data: { turbo_confirm: "このアイテムを削除しますか？" } },
                class: "button-delete" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p>ママの準備アイテムはまだありません。</p>
      <% end %>
    </div>
  </details>
</div>
<hr>
<h2>これから準備するもの</h2>
<% if @unprepared_items.any? %>
  <% @unprepared_items.each do |item| %>
    <p>
      <%= item.name %>
      （<%= item.baby? ? "赤ちゃん" : "ママ" %>）
    </p>
  <% end %>
<% else %>
  <p>これから準備するものはありません！</p>
<% end %>
